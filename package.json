{
  "name": "pm-visual",
  "version": "1.1.0",
  "description": "A lightweight visual task board that AI agents drive from the command line and owners read and steer in the browser: requirements → phases → tasks, critical path, owner gates and change requests.",
  "private": true,
  "type": "module",
  "bin": {
    "pmv": "dist/cli.js",
    "pm-visual": "dist/cli.js"
  },
  "files": [
    "dist",
    "agent",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timhuang1018/pm-visual-tool.git"
  },
  "keywords": [
    "ai-agent",
    "cli",
    "task-board",
    "flowchart",
    "project-management",
    "critical-path"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run check:lock && tsc --noEmit && npm run build:pkg",
    "start": "node dist/cli.js serve",
    "seed": "tsx server/seed-cli.ts",
    "pm": "PM_PROJECT=${PM_PROJECT:-sample} tsx cli/main.ts",
    "demo": "tsx cli/main.ts demo",
    "ux": "node .agents/skills/ux-walkthrough/scripts/walkthrough.mjs tests/ux/scenarios.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:pkg": "vite build && node scripts/build-cli.mjs",
    "prepare": "npm run build:pkg",
    "check:lock": "node scripts/check-lockfile.mjs"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@types/node": "^24.0.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@xyflow/react": "^12.11.6",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.5",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.4"
  }
}
